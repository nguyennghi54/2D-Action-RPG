  m_Name: WelcomeVillage_What should I do
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  dialogLines:
  - speaker: {fileID: 11400000, guid: cb74a88cc3199a843a43b5fb1400a5fa, type: 2}
    text: Find and kill all the purple goblins in this world.
  - speaker: {fileID: 11400000, guid: cb74a88cc3199a843a43b5fb1400a5fa, type: 2}
    text: Then you'll be able to clear the game.
  - speaker: {fileID: 11400000, guid: 70ae77a20595c0a4db47d4141d5c82d3, type: 2}
    text: On my way to save the world.
  dialogOptions: []
